<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    An RGB-D camera bolted beside the gripper, looking the same way the fingers
    point. Because it rides on the wrist, pointing the tool at something is the
    same as pointing the camera at it, and the arm can walk the camera around a
    cuboid to see sides that were hidden from the first viewpoint.

    Two frames, as ROS expects for a camera:
      wrist_camera_link           x forward, the frame Gazebo renders from
      wrist_camera_optical_frame  z forward, x right, y down, the frame image
                                  pixels are projected in
  -->

  <xacro:macro name="wrist_camera" params="prefix parent">

    <link name="${prefix}wrist_camera_link">
      <visual>
        <geometry><box size="0.025 0.05 0.02"/></geometry>
        <material name="camera_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <!-- Out to the side of the gripper body so the fingers stay out of shot,
         and turned a quarter turn so the camera's own x axis lies along the
         tool's z axis. -->
    <joint name="${prefix}wrist_camera_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}wrist_camera_link"/>
      <origin xyz="0.085 0 0.015" rpy="0 ${-pi/2} 0"/>
    </joint>

    <link name="${prefix}wrist_camera_optical_frame"/>
    <joint name="${prefix}wrist_camera_optical_joint" type="fixed">
      <parent link="${prefix}wrist_camera_link"/>
      <child link="${prefix}wrist_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="${prefix}wrist_camera_link">
      <sensor name="wrist_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>wrist_camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <!-- 320x240 keeps the colour and depth frames small enough to cross
               the ROS bridge comfortably, and from the height the arm looks
               from one pixel still covers under 1.5 mm of table, which is finer
               than the millimetre the measurements are reported to. -->
          <image>
            <width>320</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>3.0</far>
          </clip>
          <optical_frame_id>${prefix}wrist_camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
