<!--
  One cuboid. world/build.py fills in the blanks and splices as many copies of
  this as the run asks for into the world file.

  The friction and contact numbers are what let the gripper hold a box rather
  than have it slide out from between the fingers.
-->
    <model name="{name}">
      <pose>{x:.4f} {y:.4f} {z:.4f} 0 0 {yaw:.4f}</pose>
      <link name="body">
        <inertial>
          <mass>{mass:.4f}</mass>
          <inertia>
            <ixx>{ixx:.6f}</ixx><iyy>{iyy:.6f}</iyy><izz>{izz:.6f}</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>{length:.4f} {width:.4f} {height:.4f}</size></box></geometry>
          <surface>
            <friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction>
            <contact><ode><kp>1e6</kp><kd>100</kd></ode></contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>{length:.4f} {width:.4f} {height:.4f}</size></box></geometry>
          <material>
            <ambient>{red:.3f} {green:.3f} {blue:.3f} 1</ambient>
            <diffuse>{red:.3f} {green:.3f} {blue:.3f} 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>
