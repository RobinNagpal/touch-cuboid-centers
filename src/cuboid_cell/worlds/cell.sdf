<?xml version="1.0"?>
<sdf version="1.9">
  <world name="cuboid_cell">

    <!-- 4 ms steps, so the simulator publishes its clock at 250 Hz. Gazebo
         publishes /clock once per step, ROS nodes subscribe to it to run on
         simulated time, and at 1 kHz that one topic is enough to swamp a
         Python node before its camera callbacks get a look in. 250 Hz is
         still far finer than anything in this cell moves. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Renders the wrist camera. Without this the camera topics stay silent. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Serves the fingertip contact sensor. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- A second, softer light from the other side. One directional light
         leaves the far side of every cuboid in shadow, and a face that is too
         dark to read a colour off is a face the perception step loses. -->
    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.5 -0.4 -0.8</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.78 0.82 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.37 1</ambient>
            <diffuse>0.45 0.45 0.47 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The table. Its top sits at z = 0.75, which is the plane the arm, the
         cuboids and cuboid_cell/cell.py all measure from. Grey on purpose:
         the cuboids are the only saturated colours in the cell, and that is
         what the perception step keys on. -->
    <model name="table">
      <static>true</static>
      <pose>0.35 0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.4 1.2 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry><box><size>1.4 1.2 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.56 1</ambient>
            <diffuse>0.68 0.68 0.70 1</diffuse>
          </material>
        </visual>
        <visual name="leg_a"><pose>0.63 0.53 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.7</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
        <visual name="leg_b"><pose>0.63 -0.53 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.7</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
        <visual name="leg_c"><pose>-0.63 0.53 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.7</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
        <visual name="leg_d"><pose>-0.63 -0.53 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.7</size></box></geometry>
          <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.4 0.4 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- CUBOIDS -->

  </world>
</sdf>
