<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    A two-finger parallel gripper.

    Both fingers are driven independently rather than one mimicking the other,
    because a mimic joint has to be handled by the simulated hardware as well
    as by the model, and two joints commanded to the same number needs nothing
    special from anybody. Closed, the two fingers meet and act as a single
    blunt tip, which is what touches the face of a cuboid.

    Along the tool's z axis:
      0.000  tool0, the flange
      0.050  the fingers start
      0.170  the fingertips

    The fingers are long on purpose. To touch the side of a tall box the arm
    comes in from above at an angle, and short fingers would bring the body of
    the gripper down onto the top of the box before the fingertip reached the
    face.
  -->

  <xacro:macro name="parallel_gripper" params="prefix parent">

    <xacro:property name="body_size" value="0.09"/>
    <xacro:property name="body_length" value="0.05"/>
    <xacro:property name="finger_length" value="0.12"/>
    <xacro:property name="finger_thickness" value="0.012"/>
    <xacro:property name="finger_width" value="0.03"/>
    <!-- Half the fingers' thickness, so travel 0 has them just touching. -->
    <xacro:property name="finger_home" value="${finger_thickness / 2}"/>

    <link name="${prefix}gripper_body">
      <visual>
        <origin xyz="0 0 ${body_length / 2}"/>
        <geometry><box size="${body_size} ${body_size} ${body_length}"/></geometry>
        <material name="gripper_grey"><color rgba="0.25 0.25 0.28 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${body_length / 2}"/>
        <geometry><box size="${body_size} ${body_size} ${body_length}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${body_length / 2}"/>
        <mass value="0.8"/>
        <inertia ixx="0.0009" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0011"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_body"/>
      <origin xyz="0 0 0"/>
    </joint>

    <xacro:macro name="finger" params="side reflect">
      <link name="${prefix}${side}_finger">
        <visual>
          <origin xyz="0 0 ${finger_length / 2}"/>
          <geometry><box size="${finger_width} ${finger_thickness} ${finger_length}"/></geometry>
          <material name="finger_grey"><color rgba="0.6 0.6 0.62 1"/></material>
        </visual>
        <collision>
          <origin xyz="0 0 ${finger_length / 2}"/>
          <geometry><box size="${finger_width} ${finger_thickness} ${finger_length}"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 ${finger_length / 2}"/>
          <mass value="0.05"/>
          <inertia ixx="2.2e-5" ixy="0" ixz="0" iyy="2.2e-5" iyz="0" izz="4.0e-6"/>
        </inertial>
      </link>

      <joint name="${prefix}${side}_finger_joint" type="prismatic">
        <parent link="${prefix}gripper_body"/>
        <child link="${prefix}${side}_finger"/>
        <origin xyz="0 ${reflect * finger_home} ${body_length}"/>
        <axis xyz="0 ${reflect} 0"/>
        <!-- 25 N is the grip. It is far more than the few newtons needed to
             hold a wooden block against gravity, and far less than a finger
             driven at full strength into a box it cannot squash, which sends
             the box shooting out sideways. -->
        <limit lower="0.0" upper="0.04" effort="25.0" velocity="0.1"/>
      </joint>
    </xacro:macro>

    <xacro:finger side="left" reflect="1"/>
    <xacro:finger side="right" reflect="-1"/>

    <!-- Grip needs friction, and a cuboid squeezed between two frictionless
         plates just squirts out. -->
    <xacro:macro name="finger_surface" params="link">
      <gazebo reference="${link}">
        <mu1>1.6</mu1>
        <mu2>1.6</mu2>
        <kp>1e6</kp>
        <kd>100.0</kd>
      </gazebo>
    </xacro:macro>
    <xacro:finger_surface link="${prefix}left_finger"/>
    <xacro:finger_surface link="${prefix}right_finger"/>

    <!-- Contact sensors on the fingers. They are what turns "the arm went to
         where it calculated the face centre is" into "the arm felt the face".
         Both fingers carry one, because which of the two lands on a face first
         depends on how the box happens to be sitting. -->
    <xacro:macro name="finger_contact" params="side">
      <gazebo reference="${prefix}${side}_finger">
        <sensor name="${side}_fingertip_contact" type="contact">
          <always_on>true</always_on>
          <update_rate>60</update_rate>
          <contact>
            <collision>${prefix}${side}_finger_collision</collision>
          </contact>
        </sensor>
      </gazebo>
    </xacro:macro>
    <xacro:finger_contact side="left"/>
    <xacro:finger_contact side="right"/>

  </xacro:macro>
</robot>
